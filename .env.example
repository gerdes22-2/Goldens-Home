# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# (e.g. https://my-app.europe-west2.run.app)
APP_URL="MY_APP_URL"

# SMTP Configuration (Optional but recommended for direct email notifications to goldenpupshome22@gmail.com)
# To use Gmail, set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and use an App Password for SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=
NOTIFICATION_EMAIL=
SMTP_RECEIVER=

# Hugging Face API key (Optional secondary fallback for Katrina Mahra chat if Gemini fails/is not used)
HUGGING_FACE_API_KEY=

# Cloudinary Integration (Required for permanent, reliable cloud storage of edited/uploaded images)
# Create a free account at https://cloudinary.com, then get these from your dashboard console.
# You can either provide individual variables:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# OR provide the single CLOUDINARY_URL connection string:
CLOUDINARY_URL=


