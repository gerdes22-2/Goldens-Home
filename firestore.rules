rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function incoming() { return request.resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isAdmin() { 
      return request.auth != null && 
             (request.auth.token.email == 'ciarawallen7741@gmail.com' || request.auth.token.email == 'goldenpupshome22@gmail.com') && 
             request.auth.token.email_verified == true;
    }

    // Applications validation
    function isValidApplication(data) {
      return data.keys().hasAll(['id', 'fullName', 'email']) 
             && data.id is string 
             && data.fullName is string 
             && data.email is string;
    }

    // Messages validation
    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'message']) 
             && data.id is string 
             && data.name is string 
             && data.email is string 
             && data.message is string;
    }
    
    match /applications/{appId} {
      allow read: if isAdmin();
      allow create: if isValidId(appId) && isValidApplication(incoming());
      allow update: if isAdmin();
    }

    match /messages/{msgId} {
      allow read: if isAdmin();
      allow create: if isValidId(msgId) && isValidMessage(incoming());
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
